#include "goofy9341.h"
#include "pico/stdio.h"
#include "pico/time.h"
#include "hardware/gpio.h"
#include <stdio.h>
// #include <sys/stdio.h>

int main() {
    stdio_init_all();

    bool led_on = true;

    gpio_init(PICO_DEFAULT_LED_PIN);
    gpio_set_dir(PICO_DEFAULT_LED_PIN, GPIO_OUT);
    gpio_put(PICO_DEFAULT_LED_PIN, led_on);

    gpio_init(22);
    gpio_set_dir(22, GPIO_OUT);
    gpio_put(22, led_on);

    LCD_setPins(20, 17, 21, 18, 19);
    LCD_setSPIperiph(spi0);
    LCD_initDisplay();
    LCD_setRotation(0);

    while (true) {
        printf("EEEEE\n");

        // for (int y = 0; y < 200; y++) {
        //     for (int x = 0; x < 200; x++) {
        //         LCD_WritePixel(x, y, ILI9341_GREEN);
        //     }
        // }

        gpio_put(PICO_DEFAULT_LED_PIN, led_on);
        gpio_put(22, led_on);
        led_on = !led_on;
        sleep_ms(500);
    }
}
